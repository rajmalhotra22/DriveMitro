# ==========================================
# DRIVEMITRO — ENVIRONMENT CONFIGURATION
# ==========================================

# Port and App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Session JWT Secret
# Set a strong 32+ character random secret for production
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Development data is stored in `.data/store.json`. MongoDB/Atlas persistence
# is not implemented yet; setting MONGODB_URI will not connect the app.
# Configure email or WhatsApp credentials only after their integrations exist.
